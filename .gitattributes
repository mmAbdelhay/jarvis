# Every text file is LF in the working tree on every platform, whatever a
# machine's core.autocrlf says. Two things depend on it: the tests that read
# source files and match them line by line (the CSS suites, id-contract), and
# the shell integration files Jarvis generates from string literals — a CRLF
# in a zsh or bash startup file is a syntax error, and a CRLF in the
# PowerShell profile the Windows terminal sources is a stray character on
# every line.
* text=auto eol=lf

# The one exception: a Windows batch file is read by cmd.exe, whose parser
# mis-handles labels and multi-line blocks in LF-only files. The jarvisd
# launcher (packages/desktop/bin/jarvisd.cmd) is shipped as it is checked out.
*.cmd text eol=crlf

# Binary assets, never touched.
*.png binary
*.icns binary
*.ico binary
*.bin binary
*.onnx binary
