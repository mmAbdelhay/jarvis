node_modules/
dist/
*.log
design/jarvis-voice-orchestrator.html
.superpowers/
*.tsbuildinfo
packages/desktop/.jarvis-preload-*/

# Agent worktrees — transient, one per background agent
.claude/worktrees/

# Packaged app output (electron-builder)
release/

# Internal design specs and implementation plans — kept local, never published
docs/superpowers/

# Agent tooling — a local working setup, not part of the app. Untracked is not
# enough on its own: one `git add -A` would publish it.
.claude/
.agents/
skills-lock.json

# VitePress build output and cache
.vitepress/dist/
.vitepress/cache/

# Generated native project folders (Expo) — regenerated by `expo prebuild`,
# never committed; only apps/mobile/modules/pinned-socket/** and the JS/config
# sources are.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
apps/mobile/node_modules/

# Firebase's per-project Android credential (M10, push notifications):
# `app.config.ts` picks it up by name when present and omits
# `android.googleServicesFile` otherwise, so a build never fails for lacking
# one — but it must never be committed.
apps/mobile/google-services.json
