<?xml version="1.0" encoding="UTF-8"?>
<!-- labwc for Rafiq. <default/> keeps the stock key binds.
     Super alone on release focuses Jarvis; Super+key chords cancel it.
     Super+Space toggles push-to-talk; Super+L runs jarvis-lock directly,
     including live boots without jarvis-idle (deliberate deviation from
     contracts §5.15). Trade-off: jarvis-idle relaunches only lockers it
     started, so a Super+L locker that crashes or loses its lock leaves the
     session locked with no lock surface until a VT switch (fails closed;
     docs/os/threat-model.md R6). Ctrl+Alt+T opens foot.
     Super and Super+Space go through jarvis-session-key (M4 contracts §2):
     jarvis-shell in the full session, the docked chat of jarvis-classic
     in the classic one. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="/usr/libexec/jarvis/jarvis-session-key --focus" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/usr/libexec/jarvis/jarvis-session-key --voice" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="jarvis-lock" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="foot" />
    </keybind>
  </keyboard>
</labwc_config>
