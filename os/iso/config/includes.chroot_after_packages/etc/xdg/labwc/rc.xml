<?xml version="1.0" encoding="UTF-8"?>
<!-- labwc for Rafiq. <default/> keeps the stock key binds.
     Super alone on release focuses Jarvis; Super+key chords cancel it.
     Super+Space toggles push-to-talk; Super+L requests the session lock,
     handled by jarvis-idle (contracts §5.15). Ctrl+Alt+T opens foot. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="jarvis-shell --focus" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="jarvis-shell --voice" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="foot" />
    </keybind>
  </keyboard>
</labwc_config>
