#!/bin/sh
# Session autostart; labwc runs this with sh at start, live and installed.

# The login keyring. pam_gnome_keyring started the keyring daemon with the
# login password (hook 0300-boot); this completes it: it unlocks, or on the
# first login creates, the login keyring, then offers the Secret Service.
# Live boots have no password but an unlocked login keyring with none
# (live-config 2000-jarvis-live-session).
gnome-keyring-daemon --start --components=pkcs11,secrets >/dev/null 2>&1 || true

# Give user services and D-Bus activated tools access to this session (§5.14).
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP >/dev/null 2>&1 || true
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP >/dev/null 2>&1 || true

# The XDG user folders (Documents, Pictures, ...) the file dialogs and the
# computer-use tests expect; labwc runs no XDG autostart entries itself.
xdg-user-dirs-update >/dev/null 2>&1 || true

# A full-session jarvis-cu may outlive its logout; it must never attach to this
# compositor, which has no overlay (Rafiq v1.1 Plan X, Task 5).
systemctl --user stop jarvis-cu.service >/dev/null 2>&1 || true

# Desktop notifications (M2.5 §7 #15).
mako &

# Handle session lock requests, idle, lid and suspend; off on live boots.
. /usr/share/jarvis-idle/labwc/autostart

# The classic session (M4 contracts §2, §6.14): labwc -C /etc/xdg/labwc-classic.
# jarvis-classic under the same relaunch loop, but with no fallback to make
# (Plan R: os/classic/data/labwc/autostart, kept verbatim below).
JARVIS_SHELL_BIN=/usr/bin/jarvis-classic JARVIS_CLASSIC_BIN=/usr/bin/jarvis-classic /usr/share/jarvis-shell/jarvis-shell-loop &

# The installer exists only on the live ISO (removed on installed systems).
if [ -x /usr/bin/jarvis-installer ]; then jarvis-installer & fi
