# The public distro name and identity: the ONLY place they are set
# (contracts §9). "Jarvis" stays the assistant's name.
# Sourced by sh and bash. Only these six KEY="value" lines are allowed
# (lib/brand.sh refuses anything else). PRETTY_NAME is derived:
# "$DISTRO_NAME $DISTRO_VERSION (trixie)".
DISTRO_NAME="Rafiq"
DISTRO_NAME_AR="رفيق"
DISTRO_ID="rafiq"
DISTRO_VERSION="0.2"
ISO_VOLUME="Rafiq 0.2"
HOME_URL="https://github.com/mmAbdelhay/jarvis"
