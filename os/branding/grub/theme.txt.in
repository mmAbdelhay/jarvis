# @DISTRO_NAME@ GRUB theme (installed system and the ISO menu).
title-text: ""
desktop-image: "background.png"
desktop-color: "#0D1014"
terminal-font: "IBM Plex Sans Regular 16"
terminal-box: ""

+ label {
    top = 22%
    left = 0
    width = 100%
    align = "center"
    text = "@DISTRO_NAME@"
    font = "IBM Plex Sans Regular 24"
    color = "#E7EAEE"
}

+ boot_menu {
    left = 30%
    top = 34%
    width = 40%
    height = 40%
    item_font = "IBM Plex Sans Regular 16"
    item_color = "#9AA4B1"
    selected_item_font = "IBM Plex Sans Regular 16"
    selected_item_color = "#4FD8C4"
    item_height = 36
    item_padding = 8
    item_spacing = 6
    scrollbar = false
}

+ label {
    id = "__timeout__"
    top = 82%
    left = 0
    width = 100%
    align = "center"
    text = "Starting in %d s"
    font = "IBM Plex Sans Regular 16"
    color = "#8A94A1"
}
