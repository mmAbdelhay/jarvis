#!/bin/sh
# greetd owns /etc/greetd/config.toml; move it aside so ours is the config.
# Ours is not a conffile (a conffile over a diverted conffile prompts, fails
# unattended, and its purge deletes greetd's file); postinst installs it.
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package jarvis-greeter --add --rename --divert /etc/greetd/config.toml.greetd /etc/greetd/config.toml
fi
exit 0
