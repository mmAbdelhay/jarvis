#!/bin/sh
# Make "jarvis" the Plymouth theme; refresh the initramfs only on a running
# system (live-build regenerates it in hook 0300-boot; the installer runs
# update-initramfs in the target).
set -e
if [ "$1" = configure ]; then
  update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
    /usr/share/plymouth/themes/jarvis/jarvis.plymouth 150
  plymouth-set-default-theme jarvis
  if [ -d /run/systemd/system ] && command -v update-initramfs >/dev/null; then
    update-initramfs -u || true
  fi
  if [ -d /run/systemd/system ] && [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
    update-grub || true
  fi
fi
exit 0
