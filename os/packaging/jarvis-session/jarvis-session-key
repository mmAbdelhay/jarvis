#!/bin/sh
# labwc keybinds (Super, Super+Space) call this instead of jarvis-shell, so
# that in the classic desktop (chosen at login or after a fallback, M4
# contracts §2) they open the docked chat instead of starting the full shell
# over it. Test hooks: JARVIS_SHELL, JARVIS_CLASSIC.
set -u
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/jarvis"
if [ "${JARVIS_SESSION_MODE:-full}" = classic ] || [ -e "$state/classic-fallback" ]; then
  exec "${JARVIS_CLASSIC:-/usr/bin/jarvis-classic}" --chat
fi
exec "${JARVIS_SHELL:-jarvis-shell}" "$@"
