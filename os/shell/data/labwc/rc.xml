<?xml version="1.0"?>
<!--
  jarvis-shell keybinds for labwc. Plan P merges this <keyboard> block into
  /etc/xdg/labwc/rc.xml. Super alone (on release) focuses the chat; Super+Space
  starts, or sends, a voice message (M3 contracts section 5.15); Super+L runs
  jarvis-lock directly, like the session's rc.xml, so it also works on live
  boots without jarvis-idle (plan P's deliberate deviation from section 5.15;
  a crashed Super+L locker is not relaunched, docs/os/threat-model.md R6);
  Ctrl+Alt+T opens foot even when an app window has focus.
-->
<labwc_config>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="jarvis-shell --focus" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="jarvis-shell --voice" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="jarvis-lock" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="foot" />
    </keybind>
  </keyboard>
</labwc_config>
