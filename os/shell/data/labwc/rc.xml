<?xml version="1.0"?>
<!--
  jarvis-shell keybinds for labwc. Plan P merges this <keyboard> block into
  /etc/xdg/labwc/rc.xml. Super alone (on release) focuses the chat; Super+Space
  starts, or sends, a voice message; Super+L asks logind to lock the session
  (jarvis-idle runs jarvis-lock on logind's Lock signal, M3 contracts section 3);
  Ctrl+Alt+T opens foot even when an app window has focus.
-->
<labwc_config>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="jarvis-shell --focus" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="jarvis-shell --ptt" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="foot" />
    </keybind>
  </keyboard>
</labwc_config>
